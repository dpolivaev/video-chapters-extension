{
  "name": "video-chapters-generator-extension",
  "version": "1.6.1",
  "description": "Browser extension for generating AI-powered YouTube chapter timecodes",
  "author": "Dimitry Polivaev",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/dpolivaev/video-chapters-extension",
  "repository": {
    "type": "git",
    "url": "https://github.com/dpolivaev/video-chapters-extension.git"
  },
  "scripts": {
    "build:chrome": "node scripts/build.js --production",
    "build:firefox": "node scripts/build.js --firefox --production",
    "build:firefox-store": "node scripts/build.js --firefox-store --production",
    "build:firefox-dev": "node scripts/build.js --firefox-dev --production",
    "build": "npm run build:chrome && npm run build:firefox-store && npm run build:firefox-dev",
    "package:chrome": "node scripts/package.js --output dist/chrome",
    "package:firefox": "node scripts/package.js --output dist/firefox",
    "package:firefox-store": "node scripts/package.js --output dist/firefox-store",
    "package:firefox-dev": "node scripts/package.js --output dist/firefox-dev",
    "package": "npm run clean && npm run validate && npm run package:chrome && npm run package:firefox-store && npm run package:firefox-dev && npm run package:source",
    "package:source": "node scripts/package.js --source",
    "validate": "npm run lint && npm run test && npm run build",
    "ci": "npm run validate",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:old": "node scripts/test.js",
    "test:edge": "node scripts/test.js --edge",
    "test:performance": "node scripts/test.js --performance",
    "clean": "node scripts/clean.js",
    "generate-key": "node scripts/generate-key.js",
    "sign": "node scripts/sign.js",
    "dev": "node scripts/dev-server.js",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "archiver": "^8.0.0",
    "chalk": "^6.0.1",
    "chokidar": "^6.0.0",
    "commander": "^15.1.0",
    "eslint": "^10.14.0",
    "fs-extra": "^11.4.1",
    "glob": "^14.0.6",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "jimp": "^1.6.1",
    "json5": "^2.2.3",
    "ora": "^10.0.0",
    "prettier": "^3.10.1",
    "semver": "^7.8.6",
    "sharp": "^0.35.5",
    "terser": "^5.51.2",
    "web-ext": "^10.8.0",
    "webextension-polyfill": "^0.12.0"
  },
  "engines": {
    "node": "^22.22.0 || >=24.0.0"
  },
  "keywords": [
    "youtube",
    "chapters",
    "browser-extension",
    "ai",
    "gemini",
    "subtitles",
    "timecodes",
    "chrome-extension",
    "edge-extension"
  ]
}
